    x="18"
    y="12"
    width="244"
    height="270"
    rx="18"
    ry="18"
    fill="none"
    stroke="#FFFFFF"
    stroke-width="4"
  />
  <!-- House + speech-bubble outline -->
  <path
    d="M140 36
       L214 96
       C222 102 226 108 226 118
       L226 198
       C226 214 214 226 198 226
       L108 226
       L72 262
       L84 226
       L82 226
       C66 226 54 214 54 198
       L54 118
       C54 108 58 102 66 96
       Z"
    fill="none"
    stroke="#FFFFFF"
